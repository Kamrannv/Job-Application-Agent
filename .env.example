# Copy this file to ".env" and fill in the three required values.

# 1. Telegram — message @BotFather, send /newbot, paste the token here
TELEGRAM_BOT_TOKEN=

# 2. Your Telegram chat ID — message @userinfobot, it replies with your ID
TELEGRAM_CHAT_ID=

# 3. Anthropic API key — console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional

# When to search and when to send the daily report (24h, this Mac's local time)
SEARCH_TIME=09:00
REPORT_TIME=21:00

# Safety cap so one noisy day can't cost you 200 cover letters
MAX_JOBS_PER_DAY=15

# Set to false to watch the browser fill forms — useful the first few times
HEADLESS=true
